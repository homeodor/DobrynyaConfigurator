{
	"extends": "@tsconfig/svelte/tsconfig.json",

	"include": ["src/**/*", "src/node_modules"],
	"exclude": ["node_modules/*", "__sapper__/*", "public/*"],
	"compilerOptions": {
    "verbatimModuleSyntax": true,
		"lib": ["DOM", "ES2021", "DOM.Iterable"],
		"resolveJsonModule": true,
		"paths": {
			"*": ["./*", "./src/ts/*"]
		}
	}
}
